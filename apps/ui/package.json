{
  "name": "@skillforge/ui",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.visual.json",
    "visual": "playwright test",
    "visual:build": "VISUAL_BUILD=1 playwright test",
    "visual:report": "playwright show-report visual/report",
    "visual:check-originals": "node visual/check-originals.mjs",
    "visual:check-gallery": "node visual/check-gallery-absent.mjs",
    "visual:update": "playwright test --update-snapshots=missing"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@dicebear/collection": "^9.4.2",
    "@dicebear/core": "^9.4.3",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/medievalsharp": "^5.3.0",
    "@skillforge/core": "workspace:*",
    "@stylexjs/stylex": "^0.19.1",
    "@tanstack/react-query": "^5.102.2",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-table": "^8.21.3",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^0.563.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^4.12.3",
    "sileo": "0.1.4",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@stylexjs/unplugin": "^0.19.1",
    "@types/node": "^25.2.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  }
}
